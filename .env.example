# ─────────────────────────────────────────────────────────────────────────
# Copier en .env puis remplir. NE JAMAIS committer le .env.
#   cp .env.example .env && nano .env && chmod 600 .env
# ─────────────────────────────────────────────────────────────────────────

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Clés MEXC Futures.
# Conseil : restreindre la clé aux permissions Futures uniquement, et si MEXC
# le propose, la limiter à l'IP de ton VPS. Aucun droit de retrait.
MEXC_API_KEY=
MEXC_SECRET_KEY=
